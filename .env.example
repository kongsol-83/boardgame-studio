# 이 파일은 템플릿입니다. 이름을 바꾸지 말고 복사해서 쓰세요.
#
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
#
# 이름을 바꾸면 이 템플릿이 저장소에서 사라져서 다른 사람이 무엇을 채워야 하는지
# 알 수 없게 됩니다. .env 는 gitignore 되어 있으니 값은 안전합니다.
#
# ---------------------------------------------------------------------------
# 여기에는 키만 둡니다.
#
# 모델, 판수, 여백, 품질 같은 조정할 값은 전부 studio.config.json 에 있습니다.
# 각 값이 왜 그런지도 거기 주석으로 적혀 있습니다.
# ---------------------------------------------------------------------------

# BoardGameGeek 액세스 토큰 — 레퍼런스 조사(/bgs-reference)에 필요합니다.
# https://boardgamegeek.com/applications 에서 애플리케이션을 등록하고 발급받습니다.
# 개인 토큰입니다. 공유하거나 커밋하지 마세요.
BGG_API_TOKEN=

# OpenAI API 키 — 플레이 시뮬레이션(/bgs-sim)과 아트 생성(/bgs-art)에 필요합니다.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
