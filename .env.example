# 이 파일은 템플릿입니다. 이름을 바꾸지 말고 복사해서 쓰세요.
#
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
#
# 이름을 바꾸면 이 템플릿이 저장소에서 사라져서 다른 사람이 무엇을 채워야 하는지
# 알 수 없게 됩니다. .env 는 gitignore 되어 있으니 값은 안전합니다.

# ---------------------------------------------------------------------------
# BoardGameGeek — 레퍼런스 조사(/bgs-reference)에만 필요합니다.
# ---------------------------------------------------------------------------
# https://boardgamegeek.com/applications 에서 애플리케이션을 등록하고 발급받습니다.
# 이 토큰은 개인 것입니다. 공유하거나 커밋하지 마세요.
BGG_API_TOKEN=

# 랭킹 덤프가 며칠 지나면 알림을 띄울지. 기본 90일.
# BGG_RANKS_MAX_AGE_DAYS=90


# ---------------------------------------------------------------------------
# OpenAI — 플레이 시뮬레이션(/bgs-sim)과 아트 생성(/bgs-art)에만 필요합니다.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# 시뮬레이션 플레이어 모델. 기본은 가장 싼 것으로 시작해서 판단이 이상하면 올립니다.
# OPENAI_SIM_MODEL=gpt-5.4-nano

# 이미지 생성 모델.
# OPENAI_IMAGE_MODEL=gpt-image-2

# 분당 이미지 생성 제한. 계정 티어에 맞춰 올리세요. Tier 1은 5, Tier 2는 20, Tier 3은 50.
# OPENAI_IPM=5


# ---------------------------------------------------------------------------
# 산출물 언어 (선택)
# ---------------------------------------------------------------------------
# 보통은 studio.config.json 에서 정합니다. 한 번만 바꿔볼 때 이걸 쓰면
# 파일 설정보다 우선합니다. ko, en, ja, zh-CN, de, fr, es
# BGS_LANGUAGE=ko
