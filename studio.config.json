{
  // ---------------------------------------------------------------------------
  // 스튜디오 설정
  //
  // 조정할 값은 전부 여기 있습니다. .env 에는 키(시크릿)만 둡니다.
  // 이 파일은 주석을 쓸 수 있습니다(JSONC). 읽을 때 주석을 걷어냅니다.
  // ---------------------------------------------------------------------------

  // 생성되는 설계 문서(컨셉, 룰셋, 검토 리포트 등)의 언어.
  // ko, en, ja, zh-CN, de, fr, es 를 압니다. 다른 값도 막지 않고 경고만 합니다.
  // 저장소 자체의 문서는 이 설정과 무관하게 한국어를 유지합니다.
  "language": "ko",

  // 산출물에 찍히는 날짜와 시각의 기준 시간대.
  //
  // "auto" 는 이 기계의 시간대를 씁니다. 대개 이게 맞습니다.
  // 고정하고 싶으면 "Asia/Seoul" 처럼 IANA 이름을 직접 적으세요.
  //
  // 기계가 시간대를 알려주지 않으면 위 language 로 추정합니다(ko는 Asia/Seoul).
  // 다만 한국어를 쓰면서 다른 나라에 있을 수 있으니 추정은 최후 수단입니다.
  //
  // UTC로 두면 한국에서는 오전 9시 이전에 만든 파일이 전날 날짜로 찍힙니다.
  "timezone": "auto",

  "models": {
    // 시뮬레이션에서 수를 두는 플레이어. 판당 수십 번 호출되므로 여기가 비용을
    // 좌우합니다. 싼 것으로 시작해서 판단이 이상하면 올리세요.
    "sim": "gpt-5.6-luna",

    // 시뮬레이션 리포트를 쓸 때 원본 피드백을 묶고 추리는 모델.
    // 90판에서 나온 소감과 헷갈린 지점을 중복 제거하고 빈도순으로 정리합니다.
    // 리포트당 한 번만 부르므로 sim 보다 좋은 모델을 써도 부담이 적습니다.
    // 해석과 제안은 여기서 하지 않습니다. 그건 검토 단계의 에이전트 몫입니다.
    "review": "gpt-5.6-terra",

    // 아트 생성 모델. gpt-image-2 는 투명 배경을 지원하지 않습니다.
    // 배경을 따야 하는 토큰이나 미플이 필요하면 gpt-image-1.5 로 내리세요.
    "image": "gpt-image-2"
  },

  // ---------------------------------------------------------------------------
  // 인쇄. 프로젝트별로 spec.json 의 print 가 덮어씁니다.
  // ---------------------------------------------------------------------------
  "print": {
    "sheet": "A4",

    // 여백 9mm에는 근거가 있습니다.
    //
    // 포커 카드의 실제 규격은 63.5mm이고 3열이면 190.5mm입니다. A4에서 3열을
    // 지키려면 여백이 9.75mm 이하여야 합니다. 10mm로 두면 0.5mm 차이로 3열이
    // 무너져서 시트당 9장이 8장이 됩니다. 가장 흔한 규격에서 한 장을 잃는 셈입니다.
    //
    // 8mm까지 내리면 몇몇 규격에서 조금 더 얻지만 가정용 프린터의 인쇄 가능
    // 영역 여유가 얇아집니다. 9mm가 3x3을 지키면서 여유도 남는 지점입니다.
    "margin_mm": 9,

    // 아트 생성 해상도의 목표치. 컴포넌트가 크면 이보다 낮아지고, 작으면
    // 이미지 모델 최소 해상도를 넘기려고 높아집니다. 실제 값은
    // `node tools/spec.mjs resolve <slug>` 가 보고합니다.
    "dpi": 300,

    // 카드 사이 간격. 0이면 맞붙여서 공유 재단선 하나로 자릅니다.
    // 손으로 자르는 프로토타입은 0이 시트당 장수도 늘고 정렬도 쉽습니다.
    "cut_gap_mm": 0,

    // 룰북 PDF. 컴포넌트 시트와 값을 나눠 둡니다.
    //
    // 위 여백 9mm는 카드 열이 무너지지 않는 최댓값이라 나온 값입니다. 룰북은 자를
    // 것이 없고 사람이 읽는 글이라 같은 값을 쓸 이유가 없습니다. 9mm면 한 줄이
    // 192mm인데 10.5pt 한글로 50자가 넘습니다. 한글 본문은 한 줄 40자 근처가
    // 편하고, 20mm면 170mm에 46자쯤입니다.
    //
    // font_pt 는 본문 크기입니다. 제목은 여기서 비례로 커집니다.
    "rulebook": {
      "margin_mm": 20,
      "font_pt": 10.5
    }
  },

  // ---------------------------------------------------------------------------
  // 시뮬레이션
  // ---------------------------------------------------------------------------
  "sim": {
    // 한 번의 응답에 쓸 토큰 상한.
    //
    //   null   파라미터를 아예 안 보냅니다. 모델 상한까지 쓰므로 빈 응답이
    //          나올 일이 없습니다. 특별한 이유가 없으면 이걸 권합니다.
    //   숫자   비용을 묶어두고 싶을 때만. 추론 모델은 이 예산 안에서 추론을
    //          먼저 하므로, 룰북이 길면 추론이 예산을 다 먹고 본문이 빈 채로
    //          돌아옵니다. 제한하려면 4000 이상을 권하고, 그래도 빈 응답이
    //          나오면 reasoningEffort 를 낮추세요.
    "maxCompletionTokens": null,

    // 추론 강도. none, low, medium, high, xhigh (모델마다 지원 범위가 다릅니다)
    // 수를 고르는 판단은 깊은 추론이 필요 없습니다. 높이면 느려지고 비싸집니다.
    // 지원하지 않는 모델이면 자동으로 빼고 다시 보냅니다.
    "reasoningEffort": "low",

    // 동시에 돌릴 판 수. 판끼리 독립이라 올릴수록 빨라지지만
    // OpenAI 레이트 리밋에 걸리면 재시도가 늘어 오히려 느려집니다.
    "concurrency": 20,

    // 인원 구성별 기본 판수.
    //
    // 30판이면 완주율, 플레이타임, 명백한 좌석 쏠림까지 나옵니다.
    // 좌석 편중을 통계적으로 유의하게 잡으려면 5%p 차이에 약 300판,
    // 3%p에 약 800판이 필요한데, 그 정밀도는 시뮬로 얻을 게 아니라
    // 테이블에서 얻어야 합니다. 30판 승률로 카드 수치를 조정하면 오버피팅입니다.
    "games": 30,

    // 좌석 편중을 판정할 최소 판수. 이보다 적으면 리포트가 아예 판단하지 않습니다.
    // 3판에서 한 좌석이 83% 나오는 건 우연이지 신호가 아닌데,
    // 경고로 올리면 쓸데없는 개정을 부릅니다.
    "minSampleForBias": 20
  },

  // ---------------------------------------------------------------------------
  // 아트
  // ---------------------------------------------------------------------------
  "art": {
    // 생성 품질. 세로형 카드 기준 대략 low $0.005 / medium $0.041 / high $0.165 로
    // low에서 high가 33배 차이입니다.
    // 반복 중에는 low, 제출용 프로토타입은 medium, 박스아트 같은 히어로 컷만 high.
    "quality": "low",

    // 분당 이미지 생성 제한. 계정 티어에 맞추세요.
    // Tier 1은 5, Tier 2는 20, Tier 3은 50입니다.
    "imagesPerMinute": 5,

    // 스타일 앵커를 몇 장 뽑아 고를지. 승인된 앵커가 이후 모든 생성의 기준이 됩니다.
    "anchorCount": 3
  },

  // ---------------------------------------------------------------------------
  // BoardGameGeek
  // ---------------------------------------------------------------------------
  "bgg": {
    // 랭킹 덤프가 며칠 지나면 알리고 다운로드 페이지를 열지.
    "ranksMaxAgeDays": 90,

    // hydrate 기본 대상 수. 20개씩 묶어 요청하므로 20000이면 약 17분입니다.
    // 로컬 인덱스가 두꺼울수록 메커니즘 조합 분석과 희소 니치 탐색이 정확해집니다.
    "hydrateTop": 20000,

    // BGG는 공식 한도를 공개하지 않습니다. 55는 보수적으로 잡은 값입니다.
    // 429가 자주 나면 낮추세요.
    "requestsPerMinute": 55
  }
}
